# Basura de Visual Studio / cache de Python
.vs/
__pycache__/
*.pyc

# Copia de la base de datos: contiene los datos ya cargados,
# no hace falta que este en GitHub (es publico). Se usa solo
# una vez para migrar la info a la base de datos en la nube.
# (movidos a _archivo_local/ el 2026-09-15, por eso es una carpeta
# entera y no archivos sueltos como antes)
_archivo_local/

# Otros archivos de proyectos aparte que no hacen falta en el sitio
NubePuntos/conversion_log.txt

# Proyecto aparte (webscraping) que no se usa en el sitio y tiene
# una contraseña de MySQL escrita directo en el codigo
Webscraping/

# Visor de nube de puntos (Potree) que usa Comparador3D.html -- se
# queda fuera del repo solo por el tamano de los datos convertidos
# (varios GB en NubePuntos/datos_antes/, etc.), no porque no se use.
# GitHub tampoco admite archivos de ese tamano de todos modos.
NubePuntos/

# Datos crudos originales de la cuenca del rio Sinu (744MB: shapefiles,
# DEM en .tif, geodatabase). RioSinu.html usa las versiones livianas ya
# convertidas en rio_sinu_data/ (esas si van al repo); esta carpeta cruda
# se queda solo local, nunca se sube.
Sinu (2)/

# GeoTIFF pesados (>100MB, el limite duro de GitHub por archivo).
# Se quedan locales hasta que se decida donde hospedarlos de verdad
# (Vercel u otro storage) - Mapa.html los carga por URL cuando existen.
capas_pesadas/

.vercel
.env*
